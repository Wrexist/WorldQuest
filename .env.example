# Copy to .env.local. NEVER commit a real value.
# Secrets belong in edge functions and CI, never in the client bundle.

# ── Supabase (project: worldquest-dev, eu-north-1) ──────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://tjdjogidudjobxipibqb.supabase.co
# Publishable key only. It is safe in the bundle BECAUSE every table has RLS.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_cQyojmZfu6bpxKU0qYNuqQ_fFdEovBZ

# ── Cloudflare Workers/D1 (ADR 0013) — replaces the pair above when selected ─
# EXPO_PUBLIC_BACKEND=d1 with the Worker origin switches accounts, progress and
# spending to D1 (apps/mobile/src/lib/backendConfig.ts). Leave unset for legacy.
EXPO_PUBLIC_BACKEND=
EXPO_PUBLIC_D1_URL=

# ── Published pages (A05). HTTPS only; an unset one hides its row/button ─────
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_LICENCES_URL=
EXPO_PUBLIC_SUPPORT_URL=

# ── Not yet connected — see README "Connected services" ─────────────────────
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# @sentry/react-native was removed 2026-08-09 to hold the 4 MiB bundle budget — see
# apps/mobile/src/lib/reporting.ts. This var is read by nothing right now; re-add the
# dependency before setting it, or it will silently do nothing.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# ── Server-side only. MUST NOT be prefixed EXPO_PUBLIC_ ─────────────────────
