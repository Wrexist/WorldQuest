node_modules/
.pnpm-store/
dist/
build/
.turbo/
coverage/

# Expo
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# Supabase
supabase/.branches/
supabase/.temp/

# Secrets — never commit
.env
.env.*
!.env.example

# Generated from source that IS in this repo, by `pnpm generate` — which runs on
# install, so a fresh clone typechecks. Untracked deliberately: a checked-in artefact
# derivable in one command is merge conflicts for no gain, and "is it stale?" is not a
# question you can ask about a file that is rebuilt before every use.

# from packages/design/tokens.json
packages/design/src/tokens.ts
packages/design/src/tokens.css
# from packages/i18n/locales/
packages/i18n/src/keys.ts
# from packages/content/packs/geography/facts.*.json, by `pnpm edge:build`. The answer
# key the server grades against is a projection of the fact packs; a committed copy is a
# copy that can disagree with them, and the disagreement would be a user marked wrong
# for a right answer.
supabase/functions/*/_content/

# NOT ignored: packages/api/src/database.types.ts. It is generated too, but only by a
# running Postgres, which the `verify` CI job does not have — so it is committed, and
# the `database` job regenerates it against a local stack and diffs. That check is
# real only because the file is tracked.

.DS_Store
*.log
packages/*/coverage/
packages/design/preview/

# Generated pseudo-locale — rebuild with `pnpm i18n:pseudo`
packages/i18n/locales/en-XA/

# tsx's compilation cache. It lands in the working directory, which for a workspace
# script run from the root is the REPO root — so three of these were committed before
# anyone noticed them in a file listing.
tsx-0/
.tsx-*/
