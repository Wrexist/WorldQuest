# node-linker=hoisted — required for the iOS build, not a preference.
#
# pnpm's default layout is a symlink farm: every package lives in
# node_modules/.pnpm/<name>@<version>_<hash>/node_modules/<name> and is symlinked
# into place. CocoaPods walks those paths with Ruby's Pathname#realdirpath while
# generating the Pods project, and on this repo it dies:
#
#   [INSTALL_PODS] ArgumentError - pathname contains null byte
#   .../cocoapods/project.rb:452:in `realdirpath'
#   Error: pod install exited with non-zero code: 1
#
# That is CocoaPods/CocoaPods#12866 — "pnpm monorepo react-native project pod
# install raises pathname contains null byte error sometimes" — which CocoaPods'
# own error output helpfully surfaced in the failing 2026-08-09 run. It is open
# upstream with no fix, so the layout has to change on our side.
#
# `hoisted` makes pnpm write a flat, npm-shaped node_modules with no symlinks,
# which is the structure React Native's native tooling has always assumed. We
# lose pnpm's disk-space saving and its protection against phantom dependencies;
# we gain an iOS build that completes. Note the tradeoff is one-directional —
# hoisting only makes MORE modules resolvable, so it cannot break an import that
# already worked.
#
# Remove this when CocoaPods#12866 is fixed and a build proves it.
node-linker=hoisted
