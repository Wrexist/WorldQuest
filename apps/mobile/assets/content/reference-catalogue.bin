rue,193],["geo.NO.flag","NO",1,"a blue Nordic cross outlined in white on a red field","ett blått nordiskt kors med vit kant på röd botten",3,"stable",true,194],["geo.DK.flag","DK",1,"a white Nordic cross on a red field","ett vitt nordiskt kors på röd botten",3,"stable",true,195],["geo.FI.flag","FI",1,"a blue Nordic cross on a white field","ett blått nordiskt kors på vit botten",2,"stable",true,196],["geo.JP.flag","JP",1,"a red circle centred on a white field","en röd cirkel i mitten på vit botten",1,"stable",true,197],["geo.CN.flag","CN",1,"a large gold star with four smaller ones in the top corner of a red field","en stor guldstjärna med fyra mindre i övre hörnet på röd botten",2,"stable",true,198],["geo.KR.flag","KR",1,"a red and blue circle on a white field, with a black trigram in each corner","en röd och blå cirkel på vit botten, med ett svart trigram i varje hörn",3,"stable",true,199],["geo.KP.flag","KP",1,"a red star on a white circle, on a wide red band between two blue ones","en röd stjärna på en vit cirkel, på ett brett rött band mellan två blå",4,"stable",true,200],["geo.MN.flag","MN",1,"a gold Soyombo emblem on the first of three bands — red, blue, red","ett gyllene soyombo-emblem på det första av tre band — rött, blått, rött",4,"stable",true,201],["geo.FR.flag","FR",1,"three vertical bands — blue, white, red","tre lodräta band — blått, vitt, rött",1,"stable",true,202],["geo.BE.flag","BE",1,"three vertical bands — black, yellow, red","tre lodräta band — svart, gult, rött",3,"stable",true,203],["geo.DE.flag","DE",1,"three horizontal bands — black, red, gold","tre vågräta band — svart, rött, guld",2,"stable",true,204],["geo.NL.flag","NL",1,"three horizontal bands — red, white, blue","tre vågräta band — rött, vitt, blått",3,"stable",true,205],["geo.AT.flag","AT",1,"three horizontal bands — red, white, red","tre vågräta band — rött, vitt, rött",3,"stable",true,206],["geo.CH.flag","CH",1,"a white cross centred on a square red field","ett vitt kors i mitten på