e",true,324],["geo.CI.flag","CI",1,"three vertical bands — orange, white, green","tre lodräta band — orange, vitt, grönt",3,"stable",true,325],["geo.DJ.flag","DJ",1,"light blue over green, with a white triangle at the hoist holding a red star","ljusblått över grönt, med en vit triangel vid stången med en röd stjärna",4,"stable",true,326],["geo.GQ.flag","GQ",1,"green, white and red horizontal bands, with a blue triangle at the hoist and a coat of arms in the middle","gröna, vita och röda vågräta band, med en blå triangel vid stången och ett vapen i mitten",4,"stable",true,327],["geo.ER.flag","ER",1,"a red triangle from the hoist splitting green and blue, with a gold olive wreath and branch","en röd triangel från stången som delar grönt och blått, med en gyllene olivkrans och kvist",4,"stable",true,328],["geo.SZ.flag","SZ",1,"blue, yellow-edged red and blue horizontal bands, with a black and white shield and two spears in the middle","blå, gulkantade röda och blå vågräta band, med en svartvit sköld och två spjut i mitten",4,"stable",true,329],["geo.GA.flag","GA",1,"three horizontal bands — green, yellow, blue","tre vågräta band — grönt, gult, blått",4,"stable",true,330],["geo.GM.flag","GM",1,"red, blue and green horizontal bands, with thin white stripes either side of the blue","röda, blå och gröna vågräta band, med smala vita ränder på var sida om det blå",4,"stable",true,331],["geo.GN.flag","GN",1,"three vertical bands — red, yellow, green","tre lodräta band — rött, gult, grönt",4,"stable",true,332],["geo.GW.flag","GW",1,"a red vertical band with a black star at the hoist, and yellow over green","ett rött lodrätt band med en svart stjärna vid stången, och gult över grönt",5,"stable",true,333],["geo.LS.flag","LS",1,"blue, white and green horizontal bands, with a black Basotho hat on the white","blå, vita och gröna vågräta band, med en svart basothohatt på det vita",4,"stable",true,334],["geo.LR.flag","LR",1,"eleven red and white stripes, with a white star on a blue s