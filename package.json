{
  "name": "worldquest",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @worldquest/mobile start",
    "verify": "pnpm typecheck && pnpm test && pnpm content:validate && pnpm i18n:check && pnpm design:contrast",
    "typecheck": "pnpm -r --filter './packages/*' --filter './apps/*' typecheck",
    "test": "pnpm -r --filter './packages/*' test && vitest run --config vitest.edge.config.ts",
    "content:validate": "pnpm --filter @worldquest/content validate",
    "content:preview": "pnpm --filter @worldquest/content preview",
    "content:stats": "pnpm --filter @worldquest/content stats",
    "i18n:check": "pnpm --filter @worldquest/i18n check",
    "i18n:types": "pnpm --filter @worldquest/i18n types",
    "i18n:pseudo": "pnpm --filter @worldquest/i18n pseudo",
    "design:tokens": "pnpm --filter @worldquest/design build-tokens",
    "design:contrast": "pnpm --filter @worldquest/design check-contrast",
    "design:preview": "pnpm --filter @worldquest/design preview",
    "engines:simulate": "pnpm --filter @worldquest/engines simulate",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --project-id tjdjogidudjobxipibqb > packages/api/src/database.types.ts",
    "db:test": "supabase test db",
    "edge:build": "tsx supabase/functions/build.ts submit-lesson",
    "edge:deploy": "supabase functions deploy submit-lesson --project-ref tjdjogidudjobxipibqb",
    "screenshot": "esbuild scripts/screenshot/render.tsx --bundle --platform=node --format=cjs --jsx=automatic --alias:react-native=react-native-web --define:__DEV__=false --loader:.json=json --outfile=node_modules/.cache/wq-render.cjs && node node_modules/.cache/wq-render.cjs > node_modules/.cache/wq-app.html && node scripts/screenshot/shoot.cjs node_modules/.cache/wq-app.html docs/design/assets/screens"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^2.1.8",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.1",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "0.76.5",
    "react-native-web": "^0.19.13",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "$comment": "Install from the repo ROOT, never inside a package. See CLAUDE.md."
}
