{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worldquest-development-api",
  "account_id": "ce2d8a1629056491e4b7e14a65379cf7",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "API_ENABLED": "false" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "worldquest-development",
    "database_id": "4354bdf7-8e07-46d9-93d7-a0700f2f1096",
    "migrations_dir": "migrations"
  }]
}
