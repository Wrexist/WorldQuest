{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worldquest-production-api",
  "account_id": "ce2d8a1629056491e4b7e14a65379cf7",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.worldquest.dpdns.org", "custom_domain": true }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 0.1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "vars": {
    "MAIL_FROM": "WorldQuest <accounts@worldquest.dpdns.org>",
    "API_ENABLED": "false",
    "LEAGUES_ENABLED": "false",
    "CHALLENGES_ENABLED": "false"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "worldquest-production",
    "database_id": "4cd24c6e-6150-4962-9923-067aec033283",
    "migrations_dir": "migrations"
  }]
}
