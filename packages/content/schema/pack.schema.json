{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldquest.app/schema/pack.schema.json",
  "title": "WorldQuest content pack",
  "description": "Content is data, never code. This schema is what CI enforces so that adding a country \u2014 or a whole subject \u2014 is an authoring task. See docs/systems/content-pipeline.md.",
  "type": "object",
  "required": [
    "packId",
    "version",
    "subject",
    "locales",
    "license",
    "generatedAt",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "description": "e.g. geography.capitals"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "kind": {
      "enum": [
        "entities",
        "facts",
        "templates",
        "collections",
        "achievements"
      ]
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      }
    },
    "license": {
      "type": "string",
      "description": "SPDX identifier or a named licence. Required \u2014 CI rejects an asset with no recorded licence."
    },
    "attribution": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "description": "Whole values per locale. Never assembled from fragments \u2014 word order differs by language.",
      "patternProperties": {
        "^[a-z]{2}(-[A-Z]{2})?$": {
          "type": "string",
          "minLength": 1
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "description": "Every fact is sourced and dated. A wrong fact in a learning app is a P1 bug.",
      "required": [
        "name",
        "verifiedAt"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "type",
        "names"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]{2,12}$",
          "description": "ISO 3166-1 alpha-2 where one exists. Permanent \u2014 it ships in save data."
        },
        "type": {
          "type": "string",
          "enum": [
            "country",
            "capital",
            "landmark",
            "region",
            "sea",
            "river",
            "mountain",
            "species",
            "other"
          ]
        },
        "names": {
          "$ref": "#/$defs/localizedText"
        },
        "region": {
          "type": "string"
        },
        "subregion": {
          "type": "string"
        },
        "geometry": {
          "type": "string"
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "path",
              "license"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "attribution": {
                "type": "string"
              }
            }
          }
        },
        "sensitivity": {
          "enum": [
            "none",
            "review-required"
          ]
        }
      }
    },
    "fact": {
      "type": "object",
      "required": [
        "id",
        "entity",
        "attribute",
        "value",
        "difficulty",
        "source",
        "volatility"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+\\.[A-Z0-9-]+\\.[a-z0-9-]+$",
          "description": "<subject>.<entity>.<attribute>"
        },
        "entity": {
          "type": "string"
        },
        "attribute": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "value": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "names": {
              "$ref": "#/$defs/localizedText"
            },
            "number": {
              "type": "number"
            },
            "asOf": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Authored prior. The engine learns the real per-user difficulty and overrides it."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "volatility": {
          "enum": [
            "stable",
            "slow",
            "fast"
          ],
          "description": "fast facts (leaders, GDP, rankings) may never be quiz answers \u2014 CI enforces this."
        },
        "sensitivity": {
          "enum": [
            "none",
            "review-required"
          ]
        },
        "quizzable": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "template": {
      "type": "object",
      "required": [
        "id",
        "attribute",
        "modality",
        "prompt",
        "answer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^tpl\\.[a-z0-9-]+\\.[a-z0-9]+$"
        },
        "attribute": {
          "type": "string"
        },
        "modality": {
          "enum": [
            "text",
            "image",
            "map",
            "audio"
          ]
        },
        "prompt": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "description": "i18n key \u2014 never a literal string"
            },
            "params": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "answer": {
          "type": "object",
          "required": [
            "from"
          ],
          "properties": {
            "from": {
              "type": "string"
            }
          }
        },
        "distractors": {
          "type": "object",
          "required": [
            "count",
            "strategy"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "strategy": {
              "enum": [
                "same-subregion",
                "same-region",
                "visually-similar",
                "commonly-confused",
                "random-global"
              ],
              "description": "random-global is for test fixtures only \u2014 CI rejects it in a shipped pack."
            },
            "fallback": {
              "enum": [
                "same-subregion",
                "same-region",
                "visually-similar",
                "commonly-confused"
              ]
            },
            "excludeSimilarStrings": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "a11y": {
          "type": "object",
          "required": [
            "screenReaderSafe"
          ],
          "properties": {
            "screenReaderSafe": {
              "type": "boolean"
            },
            "equivalentTemplate": {
              "type": "string",
              "description": "Required when screenReaderSafe is false. Tests the SAME fact, so a blind user's learning state is identical to anyone else's."
            }
          }
        },
        "timeLimitMs": {
          "type": [
            "integer",
            "null"
          ]
        },
        "difficultyModifier": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        }
      }
    },
    "item": {
      "oneOf": [
        {
          "$ref": "#/$defs/entity"
        },
        {
          "$ref": "#/$defs/fact"
        },
        {
          "$ref": "#/$defs/template"
        },
        {
          "$ref": "#/$defs/achievement"
        }
      ]
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "threshold"
      ],
      "properties": {
        "tier": {
          "enum": [
            "bronze",
            "silver",
            "gold",
            "platinum",
            "legendary"
          ]
        },
        "threshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "counter",
            "streak",
            "threshold",
            "set-completion",
            "session",
            "composite"
          ]
        },
        "event": {
          "type": "string"
        },
        "where": {
          "type": "object"
        },
        "distinctBy": {
          "type": "string"
        },
        "metric": {
          "enum": [
            "daily_lesson",
            "perfect_lesson"
          ]
        },
        "stat": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "op": {
          "enum": [
            "and",
            "or"
          ]
        },
        "rules": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "achievement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "rule",
        "tiers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ach\\.[a-z0-9-]+\\.[a-z0-9-]+$"
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "hidden": {
          "type": "boolean"
        },
        "rule": {
          "$ref": "#/$defs/rule"
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/tier"
          }
        },
        "showProgress": {
          "type": "boolean"
        },
        "backfill": {
          "type": "boolean"
        },
        "$comment": {
          "type": "string"
        }
      }
    }
  }
}
