  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 40,
    "8": 48,
    "9": 64
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 14,
    "xl": 18,
    "2xl": 22,
    "full": 999
  },
  "depth": {
    "$comment": "Subtle two-point tactile feedback without toy-like extruded edges.",
    "button": 2,
    "card": 1,
    "chip": 1,
    "press": 2
  },
  "elevation": {
    "0": {
      "surface": "{color.bg.surface}",
      "shadow": null,
      "android": 0
    },
    "1": {
      "surface": "{color.bg.surface}",
      "shadow": "0 2 8 rgba(24,45,37,0.06)",
      "android": 2
    },
    "2": {
      "surface": "{color.bg.surfaceRaised}",
      "shadow": "0 6 16 rgba(24,45,37,0.08)",
      "android": 6
    },
    "3": {
      "surface": "{color.bg.surfaceRaised}",
      "border": "{color.border.subtle}",
      "shadow": "0 12 32 rgba(24,45,37,0.12)",
      "android": 12
    },
    "accent": {
      "shadow": "0 0 24 rgba(88,204,2,0.35)",
      "android": 8
    }
  },
  "typography": {
    "$comment": "Nunito brings rounded, legible shapes to the shared adventure interface.",
    "font": {
      "display": {
        "600": "Nunito_600SemiBold",
        "700": "Nunito_700Bold",
        "800": "Nunito_800ExtraBold",
        "900": "Nunito_900Black"
      },
      "body": {
        "400": "Nunito_400Regular",
        "600": "Nunito_600SemiBold",
        "700": "Nunito_700Bold",
        "800": "Nunito_800ExtraBold"
      }
    },
    "face": {
      "display": "display",
      "h1": "display",
      "h2": "display",
      "h3": "display",
      "body": "body",
      "bodyStrong": "body",
      "button": "display",
      "caption": "body",
      "overline": "body",
      "numeric": "display",
      "hero": "display"
    },
    "scale": {
      "$comment": "`hero` sits above `display` for the one-number moments — the XP tally on the lesson summary, and nothing else so far. It exists as a token rather than a local `fontSize: 56` because the rule in this package is that an off-scale literal is a bug; a step the scale genuinely lacked is the case that rule is for. Tabular by default: this number counts up, and proportional digits make the card twitch as it passes 9 → 10.",
      "hero": {
        "size": 56,
        "lineHeight": 64,
        "weight": "800",
        "letterSpacing": -1.2,
        "tabular": true
      },
      "display": {
        "size": 34,
        "lineHeight": 42,
        "weight": "700",
        "letterSpacing": -0.6
      },
      "h1": {
        "size": 28,
        "lineHeight": 36,
        "weight": "700",
        "letterSpacing": -0.4
      },
      "h2": {
        "size": 22,
        "lineHeight": 30,
        "weight": "700",
        "letterSpacing": -0.2
      },
      "h3": {
        "size": 18,
        "lineHeight": 24,
        "weight": "600",
        "letterSpacing": 0
      },
      "body": {
        "size": 16,
        "lineHeight": 24,
        "weight": "400",
        "letterSpacing": 0
      },
      "bodyStrong": {
        "size": 16,
        "lineHeight": 24,
        "weight": "600",
        "letterSpacing": 0
      },
      "$comment:button": "Bold rounded labels on physical controls, with sufficient contrast at every size.",
      "button": {
        "size": 16,
        "lineHeight": 24,
        "weight": "600",
        "letterSpacing": 0
      },
      "caption": {
        "size": 13,
        "lineHeight": 18,
        "weight": "400",
        "letterSpacing": 0
      },
      "overline": {
        "size": 12,
        "lineHeight": 16,
        "weight": "600",
        "letterSpacing": 0.65,
        "transform": "uppercase"
      },
      "numeric": {
        "size": 20,
        "lineHeight": 26,
        "weight": "700",
        "letterSpacing": 0,
        "tabular": true
      }
    },
    "maxFontScale": 2
  },
  "motion": {
    "$comment": "`press` is its own step because it is the shortest thing in the system and the one users feel most often — a button face travelling 4px must land instantly or the control feels soft.",
    "press": {
      "duration": 60,
      "easing": "easeOut"
    },
    "instant": {
      "duration": 100,
      "easing": "easeOut"
    },
    "quick": {
      "duration": 180,
      "easing": "easeOut"
    },
    "base": {
      "duration": 260,
      "easing": "easeInOut"
    },
    "expressive": {
      "duration": 420,
      "easing": "spring",
      "damping": 0.7,
      "stiffness": 180
    },
    "celebrate": {
      "duration": 900,
      "easing": "lottie"
    },
    "shimmer": {
      "duration": 700,
      "easing": "easeInOut"
    },
    "drift": {
      "duration": 4200,
      "easing": "easeInOut",
      "$comment": "Ambient float for decorative scenery beside the path: one slow rise and fall, looped. Slow enough to read as weather, not as something asking to be tapped; off entirely under reduced motion."
    },
    "reducedMotion": {
      "duration": 150,
      "easing": "linear",
      "$comment": "springs become fades, Lottie shows its static end frame"
    },
    "stagger": {
      "stepMs": 40,
      "maxItems": 6
    }
  },
  "layout": {
    "gutter": "{space.4}",
    "minTouchTarget": 44,
    "minTargetGap": 8,
    "baseWidth": 375,
    "minWidth": 320,
    "$comment:maxContentWidth": "How wide a column of content is ever allowed to get. Equal to the `lg` breakpoint on purpose rather than by coincidence: `lg` is already this design system's statement of where a phone layout stops being one, so the cap is that same decision applied instead of a second number to keep in step. Above it the content centres and the margins grow. Without it a 768pt tablet rendered the phone layout stretched — a full-width primary button and 280pt of dead space under the last card, which reads as unfinished rather than spacious. NOTE, because it will be asked: Home still does not fill a 13-inch screen vertically, and that is content rather than layout. Quests and Explore fill it at the same width. Home has four blocks and two of them — Friends and League — are placeholders for features that do not exist yet (v1.5 and v2.0, and HomeScreen says so where it draws them). Building a tablet-specific arrangement to fill space that real content will fill is building around a temporary state, which PROJECT.md names as the most expensive mistake available.",
    "maxContentWidth": 600,
    "breakpoints": {
      "sm": 0,
      "md": 400,
      "lg": 600
    }
  },
  "icon": {
    "sizes": {
      "inline": 16,
      "list": 20,
      "default": 24,
      "feature": 32,
      "empty": 48
    },
    "strokeWidth": 2
  },
  "contrastFloors": {
    "bodyText": 4.5,
    "largeText": 3,
    "uiBoundary": 3,
    "highContrastTheme": 7
  },
  "gradient": {
    "card": {
      "from": "{color.bg.surface}",
      "to": "{color.bg.surfaceRaised}",
      "angle": 135
