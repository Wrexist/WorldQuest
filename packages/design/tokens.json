  "color": {
    "chrome": {
      "$comment": "Studio-rendered header jewels sit on midnight blue, with clear counters and bright type.",
      "surface": "#123954",
      "edge": "#09273C",
      "counter": "#204C69",
      "counterEdge": "#082C43",
      "text": "#FFFFFF",
      "muted": "#C7DBE8"
    },
    "course": {
      "$comment": "Platform path: emerald section banners, tactile turquoise lesson faces, quiet stone future steps.",
      "banner": "#096EAD",
      "bannerEdge": "#075486",
      "face": "#83DE38",
      "edge": "#439424",
      "ink": "#173B13",
      "shine": "#D6F49D",
      "stone": "#D9EAF4",
      "stoneEdge": "#ADC9DC",
      "stoneInk": "#52685C",
      "track": "#C7D8D0",
      "bannerInk": "#FFFFFF"
    },
    "bg": {
      "canvas": "{palette.space.800}",
      "canvasGradient": [
        "{color.bg.canvas}",
        "{color.bg.canvas}"
      ],
      "surface": "{palette.surface.1}",
      "surfaceRaised": "{palette.surface.2}",
      "surfacePressed": "{palette.surface.3}"
    },
    "border": {
      "subtle": "{palette.border.subtle}",
      "strong": "{palette.border.strong}",
      "focus": "{palette.blue.400}"
    },
    "action": {
      "$comment": "Every accent that carries a label ships as a face/edge pair. The edge is the solid block the face sits on — the thing that makes a button look pressable rather than painted — and it is a real colour, never an opacity of the face, because a translucent edge over a card reads as a smudge.",
      "primary": "{palette.green.500}",
      "primaryEdge": "{palette.green.600}",
      "primaryPressed": "{palette.green.600}",
      "primaryGlow": "{palette.green.400}",
      "secondary": "{palette.blue.500}",
      "secondaryEdge": "{palette.blue.600}",
      "secondaryPressed": "{palette.blue.600}",
      "tertiary": "transparent",
      "tertiaryEdge": "{palette.border.strong}",
      "destructive": "{palette.red.600}",
      "destructiveEdge": "{palette.red.700}",
      "disabled": "{palette.surface.3}",
      "disabledEdge": "{palette.surface.2}",
      "primaryFace": "#83DE38",
      "secondaryFace": "#C1EAFF"
    },
    "option": {
      "$comment": "The answer option is the most-tapped surface in the product, so its states are named here rather than assembled from bg + feedback at each call site.",
      "idle": "{palette.surface.1}",
      "idleEdge": "{palette.border.strong}",
      "selected": "#DDF2FC",
      "selectedEdge": "{palette.blue.500}",
      "correct": "{palette.feedback.correctSurface}",
      "correctEdge": "{palette.feedback.correctBorder}",
      "wrong": "{palette.feedback.wrongSurface}",
      "wrongEdge": "{palette.feedback.wrongBorder}"
    },
    "feedback": {
      "correct": "{palette.green.400}",
      "correctSurface": "{palette.feedback.correctSurface}",
      "wrong": "{palette.feedback.wrongSurface}",
      "$comment": "Wrong answers use a calm blue-gray surface. Red belongs to hearts and destructive actions.",
      "correctEdge": "{palette.feedback.correctBorder}",
      "wrongEdge": "{palette.feedback.wrongBorder}",
      "$comment_edge": "The ring around the answer sheet in each verdict. On a dark canvas a tinted surface alone has no edge; the ring draws it. Muted like the surfaces — the wrong edge is plum, not red.",
      "neutral": "{palette.surface.2}"
    },
    "reward": {
      "xp": "{palette.gold.400}",
      "coin": "{palette.gold.400}",
      "gem": "{palette.purple.400}"
    },
    "status": {
      "streak": "{palette.flame.500}",
      "hearts": "{palette.red.500}",
      "error": "{palette.red.500}",
      "premium": "{palette.gold.400}",
      "progress": "{palette.green.400}",
      "progressTrack": "{palette.surface.3}",
      "progressHighlight": "{palette.green.300}",
      "streakHighlight": "{palette.flame.400}"
    },
    "text": {
      "primary": "{palette.text.1}",
      "secondary": "{palette.text.2}",
      "tertiary": "{palette.text.3}",
      "$comment": "All three slate text levels support ordinary text on the light surfaces. onAccent and onStreak are white for filled controls.",
      "onAccent": "#FFFFFF",
      "onStreak": "#FFFFFF",
      "onPrimary": "#173B13",
      "onSecondary": "#06466F",
      "onStatus": "#FFFFFF"
    },
    "journey": {
      "$comment": "Decorative daylight fields and path furniture. Ink always uses the standard text tokens.",
