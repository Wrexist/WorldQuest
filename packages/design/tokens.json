        "highlight": "#FFF0D7"
      },
      "silver": {
        "start": "#ECF6FF",
        "end": "#A9C5DE",
        "ink": "#203F59",
        "edge": "#708FA9",
        "highlight": "#FFFFFF"
      },
      "gold": {
        "start": "#FFF0A1",
        "end": "#F4BD3E",
        "ink": "#503607",
        "edge": "#B48113",
        "highlight": "#FFF9D9"
