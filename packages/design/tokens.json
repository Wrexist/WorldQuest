{
  "$comment": "Source of truth for every visual value in WorldQuest. Colours were sampled from docs/design/assets/mockup-v1.png. Components import the SEMANTIC layer only — a raw palette name in a component is a CI failure, because it is what makes theming, high-contrast mode and seasonal event themes possible. Spec: docs/design/design-system.md",
  "version": "1.0.0",
  "palette": {
    "space": {
      "900": "#00050F",
      "800": "#001227",
      "700": "#052342"
    },
    "surface": {
      "1": "#0A1F3C",
      "2": "#102A4D",
      "3": "#16375C"
    },
    "border": {
      "subtle": "#1B3A63"
    },
    "blue": {
      "400": "#4C9BF0",
      "500": "#1E86E8",
      "600": "#1467C4"
    },
    "green": {
      "300": "#73DD5A",
      "400": "#4FCB5C",
      "500": "#22A73A",
      "600": "#1B8D1F"
    },
    "gold": {
      "400": "#FBC24A",
      "500": "#F5A61E",
      "600": "#E08A22"
    },
    "flame": {
      "500": "#FF6A14"
    },
    "red": {
      "500": "#E5252A",
      "700": "#B01216"
    },
    "purple": {
      "500": "#A855F7"
    },
    "text": {
      "1": "#FFFFFF",
      "2": "#9FB3D1",
      "3": "#6B82A6"
    },
    "feedback": {
      "wrongSurface": "#3A2130"
    },
    "continent": {
      "EU": "#4C7BF3",
      "AS": "#F59E3C",
      "AF": "#F2C230",
      "NA": "#3FBF8F",
      "SA": "#E0663D",
      "OC": "#39C0D6",
      "AN": "#A7C7E7"
    }
  },
  "color": {
    "bg": {
      "canvas": "{palette.space.800}",
      "canvasGradient": [
        "{palette.space.700}",
        "{palette.space.900}"
      ],
      "surface": "{palette.surface.1}",
      "surfaceRaised": "{palette.surface.2}",
      "surfacePressed": "{palette.surface.3}"
    },
    "border": {
      "subtle": "{palette.border.subtle}",
      "focus": "{palette.blue.400}"
    },
    "action": {
      "primary": "{palette.green.500}",
      "primaryPressed": "{palette.green.600}",
      "secondary": "{palette.blue.500}",
      "secondaryPressed": "{palette.blue.600}",
      "tertiary": "transparent",
      "destructive": "{palette.red.700}",
      "disabled": "{palette.surface.3}"
    },
    "feedback": {
      "correct": "{palette.green.500}",
      "wrong": "{palette.feedback.wrongSurface}",
      "$comment": "wrong is a muted surface, never red — we state the truth, we do not punish",
      "neutral": "{palette.surface.2}"
    },
    "reward": {
      "xp": "{palette.gold.500}",
      "coin": "{palette.gold.400}",
      "gem": "{palette.purple.500}"
    },
    "status": {
      "streak": "{palette.flame.500}",
      "hearts": "{palette.red.500}",
      "premium": "{palette.gold.500}",
      "progress": "{palette.green.400}",
      "progressHighlight": "{palette.green.300}"
    },
    "text": {
      "primary": "{palette.text.1}",
      "secondary": "{palette.text.2}",
      "tertiary": "{palette.text.3}",
      "$comment": "tertiary is ≈3.9:1 on surface.1 — permitted at ≥18px only",
      "onAccent": "#FFFFFF"
    }
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 40,
    "8": 48,
    "9": 64
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 28,
    "full": 999
  },
  "elevation": {
    "0": {
      "surface": "{color.bg.surface}",
      "shadow": null,
      "android": 0
    },
    "1": {
      "surface": "{color.bg.surface}",
      "shadow": "0 2 8 rgba(0,0,0,0.35)",
      "android": 2
    },
    "2": {
      "surface": "{color.bg.surfaceRaised}",
      "shadow": "0 6 16 rgba(0,0,0,0.45)",
      "android": 6
    },
    "3": {
      "surface": "{color.bg.surfaceRaised}",
      "border": "{color.border.subtle}",
      "shadow": "0 12 32 rgba(0,0,0,0.55)",
      "android": 12
    },
    "accent": {
      "shadow": "0 0 24 rgba(34,167,58,0.35)",
      "android": 8
    }
  },
  "typography": {
    "font": {
      "display": {
        "600": "Baloo2_600SemiBold",
        "700": "Baloo2_700Bold"
      },
      "body": {
        "400": "Inter_400Regular",
        "500": "Inter_500Medium",
        "600": "Inter_600SemiBold",
        "700": "Inter_700Bold"
      }
    },
    "face": {
      "display": "display",
      "h1": "display",
      "h2": "display",
      "h3": "display",
      "body": "body",
      "bodyStrong": "body",
      "caption": "body",
      "overline": "body",
      "numeric": "body"
    },
    "scale": {
      "display": {
        "size": 34,
        "lineHeight": 40,
        "weight": "700",
        "letterSpacing": -0.5
      },
      "h1": {
        "size": 28,
        "lineHeight": 34,
        "weight": "700",
        "letterSpacing": -0.3
      },
      "h2": {
        "size": 22,
        "lineHeight": 28,
        "weight": "700",
        "letterSpacing": -0.2
      },
      "h3": {
        "size": 18,
        "lineHeight": 24,
        "weight": "600",
        "letterSpacing": 0
      },
      "body": {
        "size": 16,
        "lineHeight": 24,
        "weight": "400",
        "letterSpacing": 0
      },
      "bodyStrong": {
        "size": 16,
        "lineHeight": 24,
        "weight": "600",
        "letterSpacing": 0
      },
      "caption": {
        "size": 13,
        "lineHeight": 18,
        "weight": "500",
        "letterSpacing": 0
      },
      "overline": {
        "size": 11,
        "lineHeight": 14,
        "weight": "700",
        "letterSpacing": 0.8,
        "transform": "uppercase"
      },
      "numeric": {
        "size": 20,
        "lineHeight": 24,
        "weight": "700",
        "letterSpacing": 0,
        "tabular": true
      }
    },
    "maxFontScale": 2.0
  },
  "motion": {
    "instant": {
      "duration": 100,
      "easing": "easeOut"
    },
    "quick": {
      "duration": 180,
      "easing": "easeOut"
    },
    "base": {
      "duration": 260,
      "easing": "easeInOut"
    },
    "expressive": {
      "duration": 420,
      "easing": "spring",
      "damping": 0.7,
      "stiffness": 180
    },
    "celebrate": {
      "duration": 900,
      "easing": "lottie"
    },
    "reducedMotion": {
      "duration": 150,
      "easing": "linear",
      "$comment": "springs become fades, Lottie shows its static end frame"
    },
    "stagger": {
      "stepMs": 40,
      "maxItems": 6
    }
  },
  "layout": {
    "gutter": "{space.4}",
    "minTouchTarget": 44,
    "minTargetGap": 8,
    "baseWidth": 375,
    "minWidth": 320,
    "breakpoints": {
      "sm": 0,
      "md": 400,
      "lg": 600
    }
  },
  "icon": {
    "sizes": {
      "inline": 16,
      "list": 20,
      "default": 24,
      "feature": 32,
      "empty": 48
    },
    "strokeWidth": 2
  },
  "contrastFloors": {
    "bodyText": 4.5,
    "largeText": 3.0,
    "uiBoundary": 3.0,
    "highContrastTheme": 7.0
  }
}
