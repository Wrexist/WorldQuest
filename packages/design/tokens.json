    "accent": {
      "from": "{palette.blue.400}",
      "to": "{palette.blue.600}",
      "angle": 135
    },
    "reward": {
      "from": "{palette.gold.400}",
      "to": "{palette.gold.600}",
      "angle": 135
    }
  },
