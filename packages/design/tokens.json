      "android": 8
    },
    "clay": {
      "$comment": "Diffuse, low-opacity elevation blends clay surfaces into the canvas without a hard contact stripe. Pair native shadow and Android elevation; highlights stay inside the material.",
      "opacity": 0.11,
      "radius": 12,
      "offset": 2,
      "android": 2
    }
  },
  "typography": {
    "$comment": "Nunito brings rounded, legible shapes to the shared adventure interface.",
    "font": {
      "display": {
        "600": "Nunito_600SemiBold",
        "700": "Nunito_700Bold",
        "800": "Nunito_800ExtraBold",
        "900": "Nunito_900Black"
      },
      "body": {
        "400": "Nunito_400Regular",
        "600": "Nunito_600SemiBold",
        "700": "Nunito_700Bold",
        "800": "Nunito_800ExtraBold"
      }
    },
    "face": {
      "display": "display",
      "h1": "display",
      "h2": "display",
      "h3": "display",
      "body": "body",
      "bodyStrong": "body",
      "button": "display",
      "caption": "body",
      "overline": "body",
      "numeric": "display",
      "hero": "display"
    },
    "scale": {
      "$comment": "`hero` sits above `display` for the one-number moments â€” the XP tally on the lesson summary, and nothing else so far. It exists as a token rather than a local `fontSize: 56` because the rule in this package is that an off-scale literal is a bug; a step the scale genuinely lacked is the case that rule is for. Tabular by default: this number counts up, and proportional digits make the card twitch as it passes 9 â†’ 10.",
      "hero": {
        "size": 56,
        "lineHeight": 64,
        "weight": "800",
        "letterSpacing": -1.2,
        "tabular": true
      },
      "display": {
        "size": 34,
        "lineHeight": 42,
        "weight": "700",
        "letterSpacing": -0.6
      },
      "h1": {
        "size": 28,
        "lineHeight": 36,
        "weight": "700",
        "letterSpacing": -0.4
      },
      "h2": {
        "size": 22,
        "lineHeight": 30,
        "weight": "700",
        "letterSpacing": -0.2
      },
      "h3": {
        "size": 18,
        "lineHeight": 24,
        "weight": "600",
        "letterSpacing": 0
      },
      "body": {
        "size": 16,
        "lineHeight": 24,
        "weight": "400",
        "letterSpacing": 0
      },
      "bodyStrong": {
        "size": 16,
        "lineHeight": 24,
        "weight": "600",
        "letterSpacing": 0
      },
      "$comment:button": "Bold rounded labels on physical controls, with sufficient contrast at every size.",
      "button": {
        "size": 16,
        "lineHeight": 24,
        "weight": "600",
        "letterSpacing": 0
      },
      "caption": {
        "size": 13,
        "lineHeight": 18,
        "weight": "400",
        "letterSpacing": 0
      },
      "overline": {
        "size": 12,
        "lineHeight": 16,
        "weight": "600",
        "letterSpacing": 0.65,
        "transform": "uppercase"
      },
      "numeric": {
        "size": 20,
        "lineHeight": 26,
        "weight": "700",
        "letterSpacing": 0,
        "tabular": true
      }
    },
    "maxFontScale": 2
  },
  "motion": {
    "$comment": "`press` is its own step because it is the shortest thing in the system and the one users feel most often â€” a button face travelling 4px must land instantly or the control feels soft.",
    "press": {
      "duration": 60,
      "easing": "easeOut"
    },
    "instant": {
      "duration": 100,
      "easing": "easeOut"
    },
    "quick": {
      "duration": 180,
      "easing": "easeOut"
    },
    "base": {
      "duration": 260,
      "easing": "easeInOut"
    },
    "expressive": {
      "duration": 420,
      "easing": "spring",
      "damping": 0.7,
      "stiffness": 180
    },
    "celebrate": {
      "duration": 900,
      "easing": "lottie"
    },
    "shimmer": {
      "duration": 700,
      "easing": "easeInOut"
    },
    "drift": {
      "duration": 4200,
      "easing": "easeInOut",
      "$comment": "Ambient float for decorative scenery beside the path: one slow rise and fall, looped. Slow enough to read as weather, not as something asking to be tapped; off entirely under reduced motion."
    },
    "breathe": {
      "duration": 3400,
      "easing": "easeInOut",
      "$comment": "One of Atlas's breaths, in and out, looped while he is on screen. Slow, like someone at rest (about 18 a minute), so it reads as being alive rather than as a pulse asking to be tapped. Rounded to a whole number of breaths per blink cycle, which drives both. Off under reduced motion."
    },
    "blink": {
      "duration": 120,
      "easing": "linear",
      "restMs": [3400, 4800, 2600, 160, 5200],
      "$comment": "Atlas's blink: his eyes snap shut for `duration` after each rest in `restMs`, looped. A snap, not a fade: a cartoon blink is a frame swap, and a fade shows open and closed eyes at once for a few frames, a ghost. People blink every 2-10 s and never on a beat, so the rests are uneven, with one double blink (the 160). Off under reduced motion."
    },
    "reducedMotion": {
      "duration": 150,
      "easing": "linear",
      "$comment": "springs become fades, Lottie shows its static end frame"
    },
    "stagger": {
      "stepMs": 40,
      "maxItems": 6
    }
  },
  "illustration": {
    "$comment": "Cloud scenery is full soft daylight in light mode and baked night-blue art in dark mode (backdrop-dark.webp). Fading the white art instead read as grey smoke on navy, so dark is full opacity too.",
    "cloudOpacity": { "light": 1, "dark": 1 },
    "$comment:unitTint": "How strongly a course unit's header takes its continent's identity colour (palette.continent), laid over the sky clay surface. Duolingo gives every unit its own colour; ours is the continent the unit is about, so it means something. Capped by contrast, not taste: the muted caption on the blended surface stays >= 4.6:1 in light (0.25) and >= 5.4:1 in dark (0.5) for every continent.",
    "unitTint": { "light": 0.25, "dark": 0.5 },
    "$comment:edgeBlur": "The soft edges of a scrolling screen (ScrollEdges): content blurs and fades as it reaches the top and bottom, as iOS 26 does under its bars. Real blur on iOS only (expo-blur intensity, 1-100); Android and web fade. Lighter while the content is moving: a heavy blur over moving text is mush and costs the GPU every frame, so it drops for the scroll and settles back at rest. `fade` is how much of the canvas colour is laid over the blur at the very edge.",
    "edgeBlur": { "rest": 32, "moving": 10, "fade": 0.45 }
  },
  "layout": {
    "gutter": "{space.4}",
    "minTouchTarget": 44,
    "minTargetGap": 8,
    "baseWidth": 375,
    "minWidth": 320,
    "$comment:maxContentWidth": "How wide a column of content is ever allowed to get. Equal to the `lg` breakpoint on purpose rather than by coincidence: `lg` is already this design system's statement of where a phone layout stops being one, so the cap is that same decision applied instead of a second number to keep in step. Above it the content centres and the margins grow. Without it a 768pt tablet rendered the phone layout stretched â€” a full-width primary button and 280pt of dead space under the last card, which reads as unfinished rather than spacious. NOTE, because it will be asked: Home still does not fill a 13-inch screen vertically, and that is content rather than layout. Quests and Explore fill it at the same width. Home has four blocks and two of them â€” Friends and League â€” are placeholders for features that do not exist yet (v1.5 and v2.0, and HomeScreen says so where it draws them). Building a tablet-specific arrangement to fill space that real content will fill is building around a temporary state, which PROJECT.md names as the most expensive mistake available.",
    "maxContentWidth": 600,
    "breakpoints": {
      "sm": 0,
      "md": 400,
      "lg": 600
    }
  },
