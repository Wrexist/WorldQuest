+// The caller must submit with endFrameEXP first. Its flush is already enqueued
+// on glQueue before this Promise request can reach the native module.
+// This acknowledges GPU completion, not compositor scanout. Never block JS/UI.
+- (void)waitForFrameResolve:(EXPromiseResolveBlock)resolve reject:(EXPromiseRejectBlock)reject
+{
+  if (self.frameCompletionDestroyed || !self.isContextReady) {
+    reject(@"E_GL_CONTEXT_DESTROYED", @"GL context is unavailable", nil);
+    return;
+  }
+  if (self.appIsBackgrounded) {
+    reject(@"E_GL_BACKGROUND", @"GL context is backgrounded", nil);
+    return;
+  }
+  // Do not use runAsync: its wrapper touches GL even if this callback exits early.
+  dispatch_async(_glQueue, ^{
+    if (self.frameCompletionDestroyed || !self.isContextReady) {
+      reject(@"E_GL_CONTEXT_DESTROYED", @"GL context was destroyed", nil);
+      return;
+    }
+    if (self.appIsBackgrounded) {
+      reject(@"E_GL_BACKGROUND", @"GL context is backgrounded", nil);
+      return;
+    }
+    if (![EAGLContext setCurrentContext:self->_eaglCtx]) {
+      reject(@"E_GL_CONTEXT_LOST", @"GL context could not be made current", nil);
+      return;
+    }
+    glFinish();
+    GLenum error = glGetError();
+    [EAGLContext setCurrentContext:nil];
+    if (self.frameCompletionDestroyed) {
+      reject(@"E_GL_CONTEXT_DESTROYED", @"GL context was destroyed", nil);
+    } else if (self.appIsBackgrounded) {
+      reject(@"E_GL_BACKGROUND", @"GL context is backgrounded", nil);
+    } else if (error != GL_NO_ERROR) {
+      reject(@"E_GL_FRAME", [NSString stringWithFormat:@"GL frame failed (0x%x)", error], nil);
+    } else {
+      resolve(nil);
+    }
+  });
+}
